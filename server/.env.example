# Host and port the signaling server listens on.
# PORT=3000
# HOST=0.0.0.0

# CORS allow-origin for the web app. Set when the web app and server
# are served from different origins.
# ORIGIN=https://example.com

# Optional trusted-proxy configuration for accurate client IPs and rate limits.
# Use a hop count (for example, 1) only when the service is reachable exclusively
# through exactly that many trusted proxies; otherwise use trusted IP/CIDR values.
# TRUST_PROXY=

# Secret used to sign all JWTs. The server will not start without it.
# Use a cryptographically random secret with at least 32 bytes of entropy.
# JWT_SECRET=

# Shared secret used to obtain a short-lived admin dashboard JWT. Admin
# endpoints remain disabled unless this and JWT_SECRET are both set.
# ADMIN_SECRET=

# PostgreSQL connection used for rooms, profiles, and shared rate-limit counters.
# `npm run db:start` initializes local Docker PostgreSQL and applies migrations.
# For other environments, apply server/db/migrations/*.sql before deployment.
# DATABASE_URL=postgres://golive:golive@localhost:5432/golive

# Upper bounds for persisted device-room grants and room membership.
# MAX_ROOMS_PER_DEVICE=100
# MAX_MEMBERS_PER_ROOM=1000

# Managed Neon Auth settings used to verify account tokens on account features.
# Guests can still create and join rooms without these values.
# NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.build/neondb/auth
# Google account features default to off when NODE_ENV=production. Set false
# explicitly to disable them elsewhere; true enables token verification.
# GOOGLE_AUTH_ENABLED=false
# Optional override; defaults to <NEON_AUTH_BASE_URL>/.well-known/jwks.json.
# NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-east-1.aws.neon.build/neondb/auth/.well-known/jwks.json

# Cloudflare TURN credentials, used by the /session endpoint.
# Unset -> the web app falls back to STUN-only ICE servers.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Cloudflare analytics, used to compute TURN usage.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ANALYTICS_API_TOKEN=
# New relay requests switch to ExpressTURN at this monthly egress amount.
# CLOUDFLARE_TURN_SWITCH_GB=950

# ExpressTURN fallback. URLs are comma-separated. Free-plan credentials are
# static and should be rotated from the ExpressTURN dashboard if disclosed.
# EXPRESSTURN_URLS=turn:free.expressturn.com:3478
# EXPRESSTURN_USERNAME=
# EXPRESSTURN_CREDENTIAL=

# Emergency switch that prevents new ExpressTURN configurations from being
# returned. ExpressTURN enforces the free plan's monthly traffic limit.
# EXPRESSTURN_DISABLED=false
