# Host and port the signaling server listens on.
# PORT=3000
# HOST=0.0.0.0

# CORS allow-origin for the web app. Set when the web app and server
# are served from different origins.
# ORIGIN=https://example.com

# Cloudflare TURN credentials, used by the /turn-credentials endpoint.
# Unset -> the web app falls back to STUN-only ICE servers.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
