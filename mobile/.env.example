# Android emulator alias for the host's localhost. Set your host LAN address
# when testing on a physical device.
# EXPO_PUBLIC_SIGNALING_URL=http://10.0.2.2:3000

# Public web origin used to build room invite links.
# EXPO_PUBLIC_INVITE_URL=https://golive.example.com

# Optional Managed Neon Auth and native Google Sign-In configuration.
# EXPO_PUBLIC_NEON_AUTH_URL=https://ep-example.neonauth.us-east-1.aws.neon.build/neondb/auth
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional override; normally derived from the iOS client ID above.
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.example
