{
  "name": "@golive/web",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev-https": "GOLIVE_HTTPS_CERT=.certs/lan.pem GOLIVE_HTTPS_KEY=.certs/lan-key.pem vite --config vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test test/*.test.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@golive/core": "1.2.2",
    "@neondatabase/auth": "^0.5.0-beta",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
