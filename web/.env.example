# Optional: full signaling endpoint when the web app and server use
# different origins. Accepts http/https/ws/wss. Defaults to the origin
# the web app is served from.
# VITE_SIGNALING_URL=wss://signal.example.com/ws

# Neon Managed Auth URL for this Neon branch. Leave unset to use guest-only mode.
# VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-1.aws.neon.build/neondb/auth

# Google account features are enabled by default in Vite dev and disabled in
# production builds. Set false to hide sign-in locally, or true to enable it in
# production (requires GOOGLE_AUTH_ENABLED=true on the server as well).
# VITE_GOOGLE_AUTH_ENABLED=false
